rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidArea(area) {
      return area == 'information-security'
        || area == 'software-development'
        || area == 'infrastructure'
        || area == 'support'
        || area == 'devops-sre'
        || area == 'data-analytics'
        || area == 'cloud'
        || area == 'qa-testing'
        || area == 'it-project-management'
        || area == 'networks'
        || area == 'database'
        || area == 'other';
    }

    function isValidPrimaryObjective(objective) {
      return objective == 'organize-work'
        || objective == 'improve-focus'
        || objective == 'build-routine'
        || objective == 'increase-productivity'
        || objective == 'meet-goals'
        || objective == 'all';
    }

    function hasValidSecondaryAreas(areas, primaryArea) {
      return areas is list
        && areas.size() <= 5
        && areas.size() == areas.toSet().size()
        && (primaryArea == null || !areas.toSet().hasAny([primaryArea]))
        && areas.toSet().difference([
          'information-security',
          'software-development',
          'infrastructure',
          'support',
          'devops-sre',
          'data-analytics',
          'cloud',
          'qa-testing',
          'it-project-management',
          'networks',
          'database',
          'other'
        ].toSet()).size() == 0;
    }

    function hasValidSettings(settings) {
      return settings is map
        && settings.keys().hasOnly([
          'timezone',
          'locale',
          'pomodoro',
          'notifications'
        ])
        && settings.keys().hasAll([
          'timezone',
          'locale',
          'pomodoro',
          'notifications'
        ])
        && settings.timezone is string
        && settings.timezone.size() > 0
        && settings.timezone.size() <= 64
        && settings.locale == 'pt-BR'
        && settings.pomodoro is map
        && settings.pomodoro.keys().hasOnly([
          'focusMinutes',
          'shortBreakMinutes',
          'longBreakMinutes',
          'cyclesBeforeLongBreak'
        ])
        && settings.pomodoro.focusMinutes is int
        && settings.pomodoro.focusMinutes >= 1
        && settings.pomodoro.focusMinutes <= 120
        && settings.pomodoro.shortBreakMinutes is int
        && settings.pomodoro.shortBreakMinutes >= 1
        && settings.pomodoro.shortBreakMinutes <= 30
        && settings.pomodoro.longBreakMinutes is int
        && settings.pomodoro.longBreakMinutes >= 1
        && settings.pomodoro.longBreakMinutes <= 60
        && settings.pomodoro.cyclesBeforeLongBreak is int
        && settings.pomodoro.cyclesBeforeLongBreak >= 1
        && settings.pomodoro.cyclesBeforeLongBreak <= 12
        && settings.notifications is map
        && settings.notifications.keys().hasOnly(['inApp', 'push'])
        && settings.notifications.inApp is bool
        && settings.notifications.push is bool;
    }

    function isValidProjectStatus(status) {
      return status == 'planning'
        || status == 'in-progress'
        || status == 'paused'
        || status == 'completed'
        || status == 'archived';
    }

    function hasValidProjectShape() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'name',
          'description',
          'status',
          'dueAt',
          'category',
          'investedMinutes',
          'createdAt',
          'updatedAt',
          'archivedAt',
          'deletedAt'
        ])
        && data.keys().hasAll([
          'name',
          'description',
          'status',
          'dueAt',
          'category',
          'investedMinutes',
          'createdAt',
          'updatedAt',
          'archivedAt',
          'deletedAt'
        ])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 120
        && data.name.matches('.*\\S.*')
        && isValidOptionalTaskText(data.description, 5000)
        && isValidProjectStatus(data.status)
        && (data.dueAt == null || data.dueAt is timestamp)
        && isValidOptionalTaskText(data.category, 80)
        && data.investedMinutes is int
        && data.investedMinutes >= 0
        && data.investedMinutes <= 10000000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (data.deletedAt == null || data.deletedAt is timestamp)
        && ((data.status == 'archived' && data.archivedAt is timestamp)
          || (data.status != 'archived' && data.archivedAt == null));
    }

    function hasValidProjectArchiveTransition() {
      let before = resource.data;
      let after = request.resource.data;
      return (after.status == 'archived'
          && (before.status == 'archived'
            ? after.archivedAt == before.archivedAt
            : after.archivedAt == request.time))
        || (after.status != 'archived' && after.archivedAt == null);
    }

    function hasValidProjectDeletionTransition() {
      let before = resource.data;
      let after = request.resource.data;
      return before.deletedAt == null
        && (after.deletedAt == null
          || (after.deletedAt == request.time
            && after.status == 'archived'
            && after.archivedAt is timestamp));
    }

    function isValidTaskStatus(status) {
      return status == 'backlog'
        || status == 'todo'
        || status == 'in-progress'
        || status == 'completed'
        || status == 'archived';
    }

    function isValidTaskPriority(priority) {
      return priority == 'low'
        || priority == 'medium'
        || priority == 'high'
        || priority == 'critical';
    }

    function taskXpForPriority(priority) {
      return priority == 'low' ? 20
        : priority == 'medium' ? 40
        : priority == 'high' ? 75
        : priority == 'critical' ? 120
        : -1;
    }

    function minimumXpForLevel(level) {
      return 50 * (level - 1) * (level + 2);
    }

    function isValidLevelForXp(level, xp) {
      return level is int
        && level >= 1
        && xp >= minimumXpForLevel(level)
        && xp < minimumXpForLevel(level + 1);
    }

    function profilePath(userId) {
      return /databases/$(database)/documents/users/$(userId);
    }

    function taskPath(userId, taskId) {
      return /databases/$(database)/documents/users/$(userId)/tasks/$(taskId);
    }

    function xpTransactionPath(userId, transactionId) {
      return /databases/$(database)/documents/users/$(userId)/xpTransactions/$(transactionId);
    }

    function projectPath(userId, projectId) {
      return /databases/$(database)/documents/users/$(userId)/projects/$(projectId);
    }

    function projectCompletionPath(userId, projectId) {
      return /databases/$(database)/documents/users/$(userId)/projectCompletions/$(projectId);
    }

    function achievementStatsPath(userId) {
      return /databases/$(database)/documents/users/$(userId)/achievementStats/main;
    }

    function achievementEvidencePath(userId, evidenceId) {
      return /databases/$(database)/documents/users/$(userId)/achievementEvidence/$(evidenceId);
    }

    function achievementUnlockPath(userId, achievementId) {
      return /databases/$(database)/documents/users/$(userId)/achievements/$(achievementId);
    }

    function achievementTransactionId(achievementId) {
      return 'achievement__' + achievementId;
    }

    function goalPath(userId, cadence) {
      return /databases/$(database)/documents/users/$(userId)/goals/$(cadence);
    }

    function goalProgressPath(userId, progressId) {
      return /databases/$(database)/documents/users/$(userId)/goalProgress/$(progressId);
    }

    function goalEvidencePath(userId, evidenceId) {
      return /databases/$(database)/documents/users/$(userId)/goalEvidence/$(evidenceId);
    }

    function goalCompletionPath(userId, progressId) {
      return /databases/$(database)/documents/users/$(userId)/goalCompletions/$(progressId);
    }

    function goalStreakPath(userId) {
      return /databases/$(database)/documents/users/$(userId)/goalStreak/main;
    }

    function pomodoroCurrentPath(userId) {
      return /databases/$(database)/documents/users/$(userId)/pomodoroState/current;
    }

    function pomodoroSessionPath(userId, sessionId) {
      return /databases/$(database)/documents/users/$(userId)/pomodoroSessions/$(sessionId);
    }

    function isValidGoalCadence(cadence) {
      return cadence == 'daily'
        || cadence == 'weekly'
        || cadence == 'monthly';
    }

    function isValidGoalMetric(metric) {
      return metric == 'tasksCompleted'
        || metric == 'xpEarned'
        || metric == 'pomodorosCompleted'
        || metric == 'focusedSeconds';
    }

    function goalReward(cadence) {
      return cadence == 'daily' ? 30
        : cadence == 'weekly' ? 100
        : cadence == 'monthly' ? 300
        : -1;
    }

    function expectedDailyTaskGoal(goal) {
      return goal.active
          && goal.metric == 'tasksCompleted'
          && goal.target <= 50
        ? goal.target
        : null;
    }

    function hasSynchronizedDailyGoalProfile(userId) {
      let goal = getAfter(goalPath(userId, 'daily')).data;
      let profile = getAfter(profilePath(userId)).data;
      return existsAfter(goalPath(userId, 'daily'))
        && existsAfter(profilePath(userId))
        && profile.dailyTaskGoal == expectedDailyTaskGoal(goal)
        && profile.updatedAt == request.time;
    }

    function hasValidGoalShape(userId, cadence) {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'userId',
          'cadence',
          'metric',
          'target',
          'rewardXp',
          'active',
          'effectiveFromPeriodKey',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasAll([
          'userId',
          'cadence',
          'metric',
          'target',
          'rewardXp',
          'active',
          'effectiveFromPeriodKey',
          'createdAt',
          'updatedAt'
        ])
        && data.userId == userId
        && data.cadence == cadence
        && isValidGoalCadence(data.cadence)
        && isValidGoalMetric(data.metric)
        && data.target is int
        && data.target > 0
        && data.target <= 1000000000
        && data.rewardXp == goalReward(data.cadence)
        && data.active is bool
        && data.effectiveFromPeriodKey is string
        && data.effectiveFromPeriodKey.size() > 0
        && data.effectiveFromPeriodKey.size() <= 64
        && !data.effectiveFromPeriodKey.matches('.*[/].*')
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function goalMatchesProgress(goal, progress) {
      return goal.userId == progress.userId
        && goal.cadence == progress.cadence
        && goal.metric == progress.metric
        && goal.target == progress.target
        && goal.rewardXp == progress.rewardXp
        && goal.active
        && progress.periodKey >= goal.effectiveFromPeriodKey;
    }

    function hasMatchingGoalForProgress(userId, data) {
      let sourcePath = goalPath(userId, data.cadence);
      return (existsAfter(sourcePath)
          && goalMatchesProgress(getAfter(sourcePath).data, data))
        || (exists(sourcePath)
          && goalMatchesProgress(get(sourcePath).data, data));
    }

    function hasValidGoalProgressShape(userId, progressId, data) {
      return data.keys().hasOnly([
          'userId',
          'cadence',
          'periodKey',
          'timezone',
          'periodStartsAt',
          'periodEndsAt',
          'eligibleFrom',
          'metric',
          'target',
          'rewardXp',
          'current',
          'completed',
          'completedAt',
          'lastEvidenceId',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasAll([
          'userId',
          'cadence',
          'periodKey',
          'timezone',
          'periodStartsAt',
          'periodEndsAt',
          'eligibleFrom',
          'metric',
          'target',
          'rewardXp',
          'current',
          'completed',
          'completedAt',
          'lastEvidenceId',
          'createdAt',
          'updatedAt'
        ])
        && data.userId == userId
        && isValidGoalCadence(data.cadence)
        && progressId == data.cadence + '__' + data.periodKey
        && data.periodKey is string
        && data.periodKey.size() > 0
        && data.periodKey.size() <= 64
        && !data.periodKey.matches('.*[/].*')
        && data.timezone is string
        && data.timezone.size() > 0
        && data.timezone.size() <= 64
        && data.periodStartsAt is timestamp
        && data.periodEndsAt is timestamp
        && data.periodStartsAt < data.periodEndsAt
        && data.eligibleFrom is timestamp
        && data.eligibleFrom >= data.periodStartsAt
        && data.eligibleFrom < data.periodEndsAt
        && isValidGoalMetric(data.metric)
        && data.target is int
        && data.target > 0
        && data.target <= 1000000000
        && data.rewardXp == goalReward(data.cadence)
        && data.current is int
        && data.current >= 0
        && data.current <= 1000000000
        && data.completed is bool
        && (data.completedAt == null || data.completedAt is timestamp)
        && (data.lastEvidenceId == null
          || (data.lastEvidenceId is string
            && data.lastEvidenceId.size() > 0
            && data.lastEvidenceId.size() <= 512
            && !data.lastEvidenceId.matches('.*[/].*')))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function hasValidGoalProgressCreate(userId, progressId) {
      let data = request.resource.data;
      return hasValidGoalProgressShape(userId, progressId, data)
        && hasMatchingGoalForProgress(userId, data)
        && data.current == 0
        && data.completed == false
        && data.completedAt == null
        && data.lastEvidenceId == null
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function hasValidGoalProgressUpdate(userId, progressId) {
      let before = resource.data;
      let after = request.resource.data;
      let evidencePath = goalEvidencePath(userId, after.lastEvidenceId);
      let evidence = getAfter(evidencePath).data;
      let nextValue = before.current + evidence.delta;
      return hasValidGoalProgressShape(userId, progressId, after)
        && after.lastEvidenceId is string
        && after.lastEvidenceId != before.lastEvidenceId
        && !exists(evidencePath)
        && existsAfter(evidencePath)
        && evidence.progressId == progressId
        && evidence.metric == before.metric
        && after.current == nextValue
        && after.createdAt == before.createdAt
        && after.userId == before.userId
        && after.cadence == before.cadence
        && after.periodKey == before.periodKey
        && after.timezone == before.timezone
        && after.periodStartsAt == before.periodStartsAt
        && after.periodEndsAt == before.periodEndsAt
        && after.eligibleFrom == before.eligibleFrom
        && after.metric == before.metric
        && after.target == before.target
        && after.rewardXp == before.rewardXp
        && after.updatedAt == request.time
        && (before.completed
          ? (after.completed
            && after.completedAt == before.completedAt)
          : (nextValue >= before.target
            ? (after.completed
              && after.completedAt == request.time
              && !exists(goalCompletionPath(userId, progressId))
              && existsAfter(goalCompletionPath(userId, progressId)))
            : (after.completed == false && after.completedAt == null)))
        && after.diff(before).affectedKeys().hasOnly([
          'current',
          'completed',
          'completedAt',
          'lastEvidenceId',
          'updatedAt'
        ]);
    }

    function hasValidTaskGoalEvidence(userId, evidenceId, cadence, data) {
      let sourcePath = xpTransactionPath(userId, data.sourceId);
      let source = get(sourcePath).data;
      return data.sourceType == 'TASK_COMPLETED'
        && evidenceId == cadence + '__TASK_COMPLETED__' + data.sourceId
        && exists(sourcePath)
        && source.eventType == 'TASK_COMPLETED'
        && source.taskId == data.sourceId
        && source.createdAt == data.occurredAt
        && ((data.metric == 'tasksCompleted' && data.delta == 1)
          || (data.metric == 'xpEarned'
            && data.delta == source.amount));
    }

    function hasValidXpGoalEvidence(userId, evidenceId, cadence, data) {
      let sourcePath = xpTransactionPath(userId, data.sourceId);
      let source = get(sourcePath).data;
      return data.sourceType == 'XP_TRANSACTION'
        && evidenceId == cadence + '__XP_TRANSACTION__' + data.sourceId
        && exists(sourcePath)
        && source.eventType == 'ACHIEVEMENT_UNLOCKED'
        && data.metric == 'xpEarned'
        && data.delta == source.amount
        && source.createdAt == data.occurredAt;
    }

    function hasValidPomodoroGoalEvidence(userId, evidenceId, cadence, data) {
      let sourcePath = pomodoroSessionPath(userId, data.sourceId);
      let source = get(sourcePath).data;
      return data.sourceType == 'POMODORO_COMPLETED'
        && evidenceId == cadence + '__POMODORO_COMPLETED__' + data.sourceId
        && exists(sourcePath)
        && source.mode == 'focus'
        && source.sessionId == data.sourceId
        && source.completedAt == data.occurredAt
        && ((data.metric == 'pomodorosCompleted' && data.delta == 1)
          || (data.metric == 'focusedSeconds'
            && data.delta == source.plannedSeconds));
    }

    function hasValidGoalEvidenceCreate(userId, evidenceId) {
      let data = request.resource.data;
      let progressPath = goalProgressPath(userId, data.progressId);
      let progress = getAfter(progressPath).data;
      return data.keys().hasOnly([
          'progressId',
          'sourceType',
          'sourceId',
          'metric',
          'delta',
          'occurredAt',
          'recordedAt'
        ])
        && data.keys().hasAll([
          'progressId',
          'sourceType',
          'sourceId',
          'metric',
          'delta',
          'occurredAt',
          'recordedAt'
        ])
        && data.progressId is string
        && data.progressId.size() > 0
        && data.progressId.size() <= 192
        && !data.progressId.matches('.*[/].*')
        && data.sourceId is string
        && data.sourceId.size() > 0
        && data.sourceId.size() <= 128
        && !data.sourceId.matches('.*[/].*')
        && isValidGoalMetric(data.metric)
        && data.delta is int
        && data.delta >= 0
        && data.delta <= 1000000000
        && data.occurredAt is timestamp
        && data.recordedAt == request.time
        && exists(progressPath)
        && existsAfter(progressPath)
        && progress.lastEvidenceId == evidenceId
        && progress.metric == data.metric
        && data.occurredAt >= progress.eligibleFrom
        && data.occurredAt < progress.periodEndsAt
        && (hasValidTaskGoalEvidence(
            userId,
            evidenceId,
            progress.cadence,
            data
          )
          || hasValidXpGoalEvidence(
            userId,
            evidenceId,
            progress.cadence,
            data
          )
          || hasValidPomodoroGoalEvidence(
            userId,
            evidenceId,
            progress.cadence,
            data
          ));
    }

    function hasValidGoalCompletionCreate(userId, progressId) {
      let data = request.resource.data;
      let progressPath = goalProgressPath(userId, progressId);
      let before = get(progressPath).data;
      let after = getAfter(progressPath).data;
      let transactionPath = xpTransactionPath(userId, 'goal__' + progressId);
      let xpTransaction = getAfter(transactionPath).data;
      return data.keys().hasOnly([
          'progressId',
          'cadence',
          'periodKey',
          'metric',
          'target',
          'finalValue',
          'rewardXp',
          'completedAt'
        ])
        && data.keys().hasAll([
          'progressId',
          'cadence',
          'periodKey',
          'metric',
          'target',
          'finalValue',
          'rewardXp',
          'completedAt'
        ])
        && exists(progressPath)
        && existsAfter(progressPath)
        && before.completed == false
        && before.current < before.target
        && after.completed == true
        && after.completedAt == request.time
        && after.current >= after.target
        && data.progressId == progressId
        && data.cadence == after.cadence
        && data.periodKey == after.periodKey
        && data.metric == after.metric
        && data.target == after.target
        && data.finalValue == after.current
        && data.rewardXp == after.rewardXp
        && data.completedAt == request.time
        && !exists(transactionPath)
        && existsAfter(transactionPath)
        && xpTransaction.eventType == 'GOAL_COMPLETED'
        && xpTransaction.progressId == progressId;
    }

    function hasValidGoalStreakShape(data) {
      return data.keys().hasOnly([
          'current',
          'best',
          'productiveDays',
          'lastProcessedProgressId',
          'lastCompletedPeriodKey',
          'lastCompletedAt',
          'updatedAt'
        ])
        && data.keys().hasAll([
          'current',
          'best',
          'productiveDays',
          'lastProcessedProgressId',
          'lastCompletedPeriodKey',
          'lastCompletedAt',
          'updatedAt'
        ])
        && data.current is int
        && data.current >= 0
        && data.current <= 1000000000
        && data.best is int
        && data.best >= data.current
        && data.best <= 1000000000
        && data.productiveDays is int
        && data.productiveDays >= 0
        && data.productiveDays <= 1000000000
        && data.lastProcessedProgressId is string
        && data.lastProcessedProgressId.size() > 0
        && data.lastProcessedProgressId.size() <= 192
        && !data.lastProcessedProgressId.matches('.*[/].*')
        && data.lastCompletedPeriodKey is string
        && data.lastCompletedPeriodKey.size() > 0
        && data.lastCompletedPeriodKey.size() <= 64
        && data.lastCompletedAt is timestamp
        && data.updatedAt is timestamp;
    }

    function hasNewDailyCompletionForStreak(userId, data) {
      let completionPath = goalCompletionPath(
        userId,
        data.lastProcessedProgressId
      );
      let completion = getAfter(completionPath).data;
      return !exists(completionPath)
        && existsAfter(completionPath)
        && completion.cadence == 'daily'
        && completion.progressId == data.lastProcessedProgressId
        && completion.completedAt == request.time;
    }

    function hasValidGoalStreakCreate(userId, streakId) {
      let after = request.resource.data;
      let completion = getAfter(goalCompletionPath(
        userId,
        after.lastProcessedProgressId
      )).data;
      return streakId == 'main'
        && hasValidGoalStreakShape(after)
        && hasNewDailyCompletionForStreak(userId, after)
        && after.current == 1
        && after.best == 1
        && after.productiveDays == 1
        && after.lastCompletedPeriodKey == completion.periodKey
        && after.lastCompletedAt == request.time
        && after.updatedAt == request.time
        && getAfter(profilePath(userId)).data.streak == 1;
    }

    function hasValidGoalStreakUpdate(userId, streakId) {
      let before = resource.data;
      let after = request.resource.data;
      let completion = getAfter(goalCompletionPath(
        userId,
        after.lastProcessedProgressId
      )).data;
      let newProgress = getAfter(goalProgressPath(
        userId,
        after.lastProcessedProgressId
      )).data;
      let priorProgress = get(goalProgressPath(
        userId,
        'daily__' + before.lastCompletedPeriodKey
      )).data;
      let advances = newProgress.periodStartsAt > priorProgress.periodStartsAt;
      let consecutive = newProgress.periodStartsAt == priorProgress.periodEndsAt;
      let expectedCurrent = consecutive ? before.current + 1 : 1;
      let expectedBest = expectedCurrent > before.best
        ? expectedCurrent
        : before.best;
      return streakId == 'main'
        && hasValidGoalStreakShape(after)
        && hasNewDailyCompletionForStreak(userId, after)
        && after.productiveDays == before.productiveDays + 1
        && after.lastProcessedProgressId != before.lastProcessedProgressId
        && (advances
          ? (after.current == expectedCurrent
            && after.best == expectedBest
            && after.lastCompletedPeriodKey == completion.periodKey
            && after.lastCompletedAt == request.time)
          : (after.current == before.current
            && after.best == before.best
            && after.lastCompletedPeriodKey == before.lastCompletedPeriodKey
            && after.lastCompletedAt == before.lastCompletedAt))
        && after.updatedAt == request.time
        && getAfter(profilePath(userId)).data.streak == after.current;
    }

    function isValidPomodoroMode(mode) {
      return mode == 'focus'
        || mode == 'shortBreak'
        || mode == 'longBreak';
    }

    function expectedPomodoroSeconds(profile, mode) {
      return mode == 'focus'
        ? profile.settings.pomodoro.focusMinutes * 60
        : mode == 'shortBreak'
          ? profile.settings.pomodoro.shortBreakMinutes * 60
          : mode == 'longBreak'
            ? profile.settings.pomodoro.longBreakMinutes * 60
            : -1;
    }

    function hasValidPomodoroCurrentCreate(userId, stateId) {
      let data = request.resource.data;
      let profile = get(profilePath(userId)).data;
      return stateId == 'current'
        && data.keys().hasOnly([
          'userId',
          'sessionId',
          'mode',
          'plannedSeconds',
          'startedAt',
          'expectedEndAt'
        ])
        && data.keys().hasAll([
          'userId',
          'sessionId',
          'mode',
          'plannedSeconds',
          'startedAt',
          'expectedEndAt'
        ])
        && data.userId == userId
        && data.sessionId is string
        && data.sessionId.size() > 0
        && data.sessionId.size() <= 128
        && !data.sessionId.matches('.*[/].*')
        && isValidPomodoroMode(data.mode)
        && data.plannedSeconds is int
        && data.plannedSeconds == expectedPomodoroSeconds(profile, data.mode)
        && data.startedAt is timestamp
        && data.startedAt <= request.time
        && data.startedAt >= request.time - duration.value(10, 's')
        && data.expectedEndAt
          == data.startedAt + duration.value(data.plannedSeconds, 's');
    }

    function hasValidPomodoroSessionCreate(userId, sessionId) {
      let data = request.resource.data;
      let currentPath = pomodoroCurrentPath(userId);
      let current = get(currentPath).data;
      return data.keys().hasOnly([
          'userId',
          'sessionId',
          'mode',
          'plannedSeconds',
          'startedAt',
          'expectedEndAt',
          'completedAt'
        ])
        && data.keys().hasAll([
          'userId',
          'sessionId',
          'mode',
          'plannedSeconds',
          'startedAt',
          'expectedEndAt',
          'completedAt'
        ])
        && exists(currentPath)
        && !existsAfter(currentPath)
        && data.userId == userId
        && data.sessionId == sessionId
        && data.sessionId == current.sessionId
        && data.mode == current.mode
        && data.plannedSeconds == current.plannedSeconds
        && data.startedAt == current.startedAt
        && data.expectedEndAt == current.expectedEndAt
        && data.completedAt == request.time
        && request.time >= current.expectedEndAt;
    }

    function isKnownAchievement(achievementId) {
      return achievementId == 'first-mission'
        || achievementId == 'tasks-10'
        || achievementId == 'tasks-50'
        || achievementId == 'tasks-100'
        || achievementId == 'first-pomodoro'
        || achievementId == 'pomodoros-10'
        || achievementId == 'pomodoros-50'
        || achievementId == 'streak-3'
        || achievementId == 'streak-7'
        || achievementId == 'streak-14'
        || achievementId == 'streak-30'
        || achievementId == 'streak-60'
        || achievementId == 'streak-100'
        || achievementId == 'streak-365'
        || achievementId == 'perfect-week'
        || achievementId == 'first-project'
        || achievementId == 'projects-10';
    }

    function isAchievementSourceAvailable(achievementId) {
      return achievementId == 'first-mission'
        || achievementId == 'tasks-10'
        || achievementId == 'tasks-50'
        || achievementId == 'tasks-100'
        || achievementId == 'first-pomodoro'
        || achievementId == 'pomodoros-10'
        || achievementId == 'pomodoros-50'
        || achievementId == 'streak-3'
        || achievementId == 'streak-7'
        || achievementId == 'streak-14'
        || achievementId == 'streak-30'
        || achievementId == 'streak-60'
        || achievementId == 'streak-100'
        || achievementId == 'streak-365'
        || achievementId == 'first-project'
        || achievementId == 'projects-10';
    }

    function achievementMetric(achievementId) {
      return achievementId == 'first-mission'
          || achievementId == 'tasks-10'
          || achievementId == 'tasks-50'
          || achievementId == 'tasks-100' ? 'tasksCompleted'
        : achievementId == 'first-pomodoro'
          || achievementId == 'pomodoros-10'
          || achievementId == 'pomodoros-50' ? 'pomodorosCompleted'
        : achievementId == 'streak-3'
          || achievementId == 'streak-7'
          || achievementId == 'streak-14'
          || achievementId == 'streak-30'
          || achievementId == 'streak-60'
          || achievementId == 'streak-100'
          || achievementId == 'streak-365' ? 'bestStreak'
        : achievementId == 'perfect-week' ? 'perfectWeeks'
        : achievementId == 'first-project'
          || achievementId == 'projects-10' ? 'projectsCompleted'
        : 'invalid';
    }

    function achievementTarget(achievementId) {
      return achievementId == 'first-mission' ? 1
        : achievementId == 'tasks-10' ? 10
        : achievementId == 'tasks-50' ? 50
        : achievementId == 'tasks-100' ? 100
        : achievementId == 'first-pomodoro' ? 1
        : achievementId == 'pomodoros-10' ? 10
        : achievementId == 'pomodoros-50' ? 50
        : achievementId == 'streak-3' ? 3
        : achievementId == 'streak-7' ? 7
        : achievementId == 'streak-14' ? 14
        : achievementId == 'streak-30' ? 30
        : achievementId == 'streak-60' ? 60
        : achievementId == 'streak-100' ? 100
        : achievementId == 'streak-365' ? 365
        : achievementId == 'perfect-week' ? 1
        : achievementId == 'first-project' ? 1
        : achievementId == 'projects-10' ? 10
        : -1;
    }

    function achievementXp(achievementId) {
      return achievementId == 'first-mission' ? 25
        : achievementId == 'tasks-10' ? 50
        : achievementId == 'tasks-50' ? 150
        : achievementId == 'tasks-100' ? 300
        : achievementId == 'first-pomodoro' ? 25
        : achievementId == 'pomodoros-10' ? 50
        : achievementId == 'pomodoros-50' ? 150
        : achievementId == 'streak-3' ? 50
        : achievementId == 'streak-7' ? 100
        : achievementId == 'streak-14' ? 200
        : achievementId == 'streak-30' ? 400
        : achievementId == 'streak-60' ? 500
        : achievementId == 'streak-100' ? 750
        : achievementId == 'streak-365' ? 1000
        : achievementId == 'perfect-week' ? 200
        : achievementId == 'first-project' ? 75
        : achievementId == 'projects-10' ? 300
        : -1;
    }

    function achievementName(achievementId) {
      return achievementId == 'first-mission' ? 'Primeira Missão'
        : achievementId == 'tasks-10' ? '10 tarefas concluídas'
        : achievementId == 'tasks-50' ? '50 tarefas concluídas'
        : achievementId == 'tasks-100' ? '100 tarefas concluídas'
        : achievementId == 'first-pomodoro' ? 'Primeiro Pomodoro'
        : achievementId == 'pomodoros-10' ? '10 Pomodoros'
        : achievementId == 'pomodoros-50' ? '50 Pomodoros'
        : achievementId == 'streak-3' ? '3 dias de streak'
        : achievementId == 'streak-7' ? '7 dias de streak'
        : achievementId == 'streak-14' ? '14 dias de streak'
        : achievementId == 'streak-30' ? '30 dias de streak'
        : achievementId == 'streak-60' ? '60 dias de streak'
        : achievementId == 'streak-100' ? '100 dias de streak'
        : achievementId == 'streak-365' ? '365 dias de streak'
        : achievementId == 'perfect-week' ? 'Semana Perfeita'
        : achievementId == 'first-project' ? 'Primeiro projeto concluído'
        : achievementId == 'projects-10' ? '10 projetos concluídos'
        : '';
    }

    function achievementProgress(stats, achievementId) {
      let metric = achievementMetric(achievementId);
      return metric == 'tasksCompleted' ? stats.tasksCompleted
        : metric == 'pomodorosCompleted' ? stats.pomodorosCompleted
        : metric == 'bestStreak' ? stats.bestStreak
        : metric == 'perfectWeeks' ? stats.perfectWeeks
        : metric == 'projectsCompleted' ? stats.projectsCompleted
        : -1;
    }

    function isXpWindowExpired(profile) {
      return profile.xpWindowStartedAt == null
        || request.time >= profile.xpWindowStartedAt + duration.value(24, 'h');
    }

    function expectedXpAmountForReward(profile, reward) {
      return !isXpWindowExpired(profile)
          && profile.xpWindowAmount + reward > 1000
        ? 0
        : reward;
    }

    function expectedXpTransactionAmount(userId, priority) {
      let profile = get(profilePath(userId)).data;
      return expectedXpAmountForReward(profile, taskXpForPriority(priority));
    }

    function hasXpTransactionAfter(userId, taskId) {
      return existsAfter(xpTransactionPath(userId, taskId));
    }

    function isValidOptionalTaskText(value, maximumSize) {
      return value == null
        || (value is string
          && value.size() > 0
          && value.size() <= maximumSize);
    }

    function hasValidTaskProjectValue() {
      let data = request.resource.data;
      return !data.keys().hasAny(['projectId'])
        || data.projectId == null
        || (data.projectId is string
          && data.projectId.size() > 0
          && data.projectId.size() <= 128);
    }

    function isActiveTaskProject(userId) {
      let projectId = request.resource.data.projectId;
      let projectPath = /databases/$(database)/documents/users/$(userId)/projects/$(projectId);
      return exists(projectPath) && get(projectPath).data.deletedAt == null;
    }

    function hasValidTaskProjectForCreate(userId) {
      let data = request.resource.data;
      return !data.keys().hasAny(['projectId'])
        || data.projectId == null
        || isActiveTaskProject(userId);
    }

    function hasValidTaskProjectForUpdate(userId) {
      let data = request.resource.data;
      return !data.keys().hasAny(['projectId'])
        || data.projectId == null
        || isActiveTaskProject(userId)
        || (resource.data.keys().hasAny(['projectId'])
          && data.projectId == resource.data.projectId);
    }

    function hasValidTaskKanbanOrder() {
      let data = request.resource.data;
      return !data.keys().hasAny(['kanbanOrder'])
        || data.kanbanOrder == null
        || ((data.kanbanOrder is int || data.kanbanOrder is float)
          && data.kanbanOrder >= 0
          && data.kanbanOrder <= 1000000000000);
    }

    function isValidTaskTag(tag) {
      return tag is string && tag.size() > 0 && tag.size() <= 32;
    }

    function hasValidTaskTags(tags) {
      return tags is list
        && tags.size() <= 10
        && tags.size() == tags.toSet().size()
        && (tags.size() < 1 || isValidTaskTag(tags[0]))
        && (tags.size() < 2 || isValidTaskTag(tags[1]))
        && (tags.size() < 3 || isValidTaskTag(tags[2]))
        && (tags.size() < 4 || isValidTaskTag(tags[3]))
        && (tags.size() < 5 || isValidTaskTag(tags[4]))
        && (tags.size() < 6 || isValidTaskTag(tags[5]))
        && (tags.size() < 7 || isValidTaskTag(tags[6]))
        && (tags.size() < 8 || isValidTaskTag(tags[7]))
        && (tags.size() < 9 || isValidTaskTag(tags[8]))
        && (tags.size() < 10 || isValidTaskTag(tags[9]));
    }

    function hasValidTaskShape() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'title',
          'description',
          'category',
          'priority',
          'status',
          'project',
          'projectId',
          'kanbanOrder',
          'dueAt',
          'estimateMinutes',
          'tags',
          'xp',
          'createdAt',
          'updatedAt',
          'completedAt'
        ])
        && data.keys().hasAll([
          'title',
          'description',
          'category',
          'priority',
          'status',
          'project',
          'dueAt',
          'estimateMinutes',
          'tags',
          'xp',
          'createdAt',
          'updatedAt',
          'completedAt'
        ])
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 160
        && data.title.matches('.*\\S.*')
        && isValidOptionalTaskText(data.description, 5000)
        && isValidOptionalTaskText(data.category, 80)
        && isValidTaskPriority(data.priority)
        && isValidTaskStatus(data.status)
        && isValidOptionalTaskText(data.project, 80)
        && hasValidTaskProjectValue()
        && hasValidTaskKanbanOrder()
        && (data.dueAt == null || data.dueAt is timestamp)
        && (data.estimateMinutes == null
          || (data.estimateMinutes is int
            && data.estimateMinutes >= 1
            && data.estimateMinutes <= 1440))
        && hasValidTaskTags(data.tags)
        && data.xp is int
        && data.xp == taskXpForPriority(data.priority)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && ((data.status == 'completed' && data.completedAt is timestamp)
          || (data.status == 'archived'
            && (data.completedAt == null || data.completedAt is timestamp))
          || ((data.status == 'backlog'
              || data.status == 'todo'
              || data.status == 'in-progress')
            && data.completedAt == null));
    }

    function hasValidTaskCompletionTransition() {
      let before = resource.data;
      let after = request.resource.data;
      return (after.status == 'completed'
          && (before.status == 'completed'
            ? after.completedAt == before.completedAt
            : after.completedAt == request.time))
        || (after.status == 'archived'
          && after.completedAt == before.completedAt)
        || ((after.status == 'backlog'
            || after.status == 'todo'
            || after.status == 'in-progress')
          && after.completedAt == null);
    }

    function hasValidProfileShape(userId) {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'uid',
          'name',
          'email',
          'avatar',
          'primaryArea',
          'secondaryAreas',
          'primaryObjective',
          'dailyTaskGoal',
          'level',
          'xp',
          'lastXpTransactionId',
          'xpWindowStartedAt',
          'xpWindowAmount',
          'streak',
          'settings',
          'onboardingCompleted',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasAll([
          'uid',
          'name',
          'email',
          'avatar',
          'primaryArea',
          'secondaryAreas',
          'primaryObjective',
          'dailyTaskGoal',
          'level',
          'xp',
          'lastXpTransactionId',
          'xpWindowStartedAt',
          'xpWindowAmount',
          'streak',
          'settings',
          'onboardingCompleted',
          'createdAt',
          'updatedAt'
        ])
        && data.uid == userId
        && data.uid is string
        && data.name is string
        && data.name.size() >= 2
        && data.name.size() <= 80
        && data.name.matches('.*\\S.*\\S.*')
        && data.email is string
        && data.email.size() <= 254
        && (data.avatar == null
          || (data.avatar is string && data.avatar.size() <= 2048))
        && (data.primaryArea == null || isValidArea(data.primaryArea))
        && hasValidSecondaryAreas(data.secondaryAreas, data.primaryArea)
        && (data.primaryObjective == null
          || isValidPrimaryObjective(data.primaryObjective))
        && (data.dailyTaskGoal == null
          || (data.dailyTaskGoal is int
            && data.dailyTaskGoal >= 1
            && data.dailyTaskGoal <= 50))
        && data.level is int
        && data.level >= 1
        && data.xp is int
        && data.xp >= 0
        && data.xp <= 1000000000
        && isValidLevelForXp(data.level, data.xp)
        && (data.lastXpTransactionId == null
          || (data.lastXpTransactionId is string
            && data.lastXpTransactionId.size() > 0
            && data.lastXpTransactionId.size() <= 128
            && !data.lastXpTransactionId.matches('.*[/].*')))
        && (data.xpWindowStartedAt == null
          || data.xpWindowStartedAt is timestamp)
        && data.xpWindowAmount is int
        && data.xpWindowAmount >= 0
        && data.xpWindowAmount <= 1000
        && data.streak is int
        && hasValidSettings(data.settings)
        && data.onboardingCompleted is bool
        && (!data.onboardingCompleted || data.primaryArea != null)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function hasValidRegularProfileUpdate(userId) {
      let before = resource.data;
      let after = request.resource.data;
      return after.level == before.level
        && after.xp == before.xp
        && after.streak == before.streak
        && (!before.keys().hasAll(['dailyTaskGoal'])
          ? after.dailyTaskGoal == null
          : (after.dailyTaskGoal == before.dailyTaskGoal
            || hasSynchronizedDailyGoalProfile(userId)))
        && (!before.keys().hasAll(['lastXpTransactionId'])
          ? after.lastXpTransactionId == null
          : after.lastXpTransactionId == before.lastXpTransactionId)
        && (!before.keys().hasAll(['xpWindowStartedAt'])
          ? after.xpWindowStartedAt == null
          : after.xpWindowStartedAt == before.xpWindowStartedAt)
        && (!before.keys().hasAll(['xpWindowAmount'])
          ? after.xpWindowAmount == 0
          : after.xpWindowAmount == before.xpWindowAmount)
        && (!before.onboardingCompleted || after.onboardingCompleted)
        && (before.onboardingCompleted
          || !after.onboardingCompleted
          || isValidPrimaryObjective(after.primaryObjective))
        && (!before.onboardingCompleted
          || !before.keys().hasAll(['primaryObjective'])
          || before.primaryObjective == null
          || after.primaryObjective != null)
        && after.diff(before).affectedKeys().hasOnly([
          'name',
          'email',
          'avatar',
          'primaryArea',
          'secondaryAreas',
          'primaryObjective',
          'dailyTaskGoal',
          'settings',
          'onboardingCompleted',
          'lastXpTransactionId',
          'xpWindowStartedAt',
          'xpWindowAmount',
          'updatedAt'
        ]);
    }

    function hasValidXpProfileTransactionIdentity(transactionId, xpTransaction) {
      return (xpTransaction.eventType == 'TASK_COMPLETED'
          && xpTransaction.taskId == transactionId)
        || (xpTransaction.eventType == 'ACHIEVEMENT_UNLOCKED'
          && transactionId
            == achievementTransactionId(xpTransaction.achievementId))
        || (xpTransaction.eventType == 'GOAL_COMPLETED'
          && transactionId == 'goal__' + xpTransaction.progressId);
    }

    function hasValidXpProfileUpdate(userId) {
      let before = resource.data;
      let after = request.resource.data;
      let transactionId = after.lastXpTransactionId;
      let transactionPath = xpTransactionPath(userId, transactionId);
      let xpTransaction = getAfter(transactionPath).data;
      let windowExpired = isXpWindowExpired(before);
      return transactionId is string
        && transactionId.size() > 0
        && transactionId.size() <= 128
        && !exists(transactionPath)
        && existsAfter(transactionPath)
        && xpTransaction.userId == userId
        && hasValidXpProfileTransactionIdentity(
          transactionId,
          xpTransaction
        )
        && xpTransaction.amount > 0
        && after.xp == before.xp + xpTransaction.amount
        && after.level == xpTransaction.levelAfter
        && isValidLevelForXp(after.level, after.xp)
        && (windowExpired
          ? (after.xpWindowStartedAt == request.time
            && after.xpWindowAmount == xpTransaction.amount)
          : (after.xpWindowStartedAt == before.xpWindowStartedAt
            && after.xpWindowAmount
              == before.xpWindowAmount + xpTransaction.amount))
        && after.xpWindowAmount <= 1000
        && after.dailyTaskGoal == before.dailyTaskGoal
        && (after.streak == before.streak
          || (xpTransaction.eventType == 'GOAL_COMPLETED'
            && xpTransaction.cadence == 'daily'
            && getAfter(goalStreakPath(userId)).data.current == after.streak
            && getAfter(goalStreakPath(userId)).data.lastProcessedProgressId
              == xpTransaction.progressId
            && getAfter(goalStreakPath(userId)).data.updatedAt == request.time))
        && after.diff(before).affectedKeys().hasOnly([
          'xp',
          'level',
          'lastXpTransactionId',
          'xpWindowStartedAt',
          'xpWindowAmount',
          'streak',
          'updatedAt'
        ]);
    }

    function hasValidZeroXpGoalStreakProfileUpdate(userId) {
      let before = resource.data;
      let after = request.resource.data;
      let streak = getAfter(goalStreakPath(userId)).data;
      let transactionPath = xpTransactionPath(
        userId,
        'goal__' + streak.lastProcessedProgressId
      );
      let xpTransaction = getAfter(transactionPath).data;
      return after.xp == before.xp
        && after.level == before.level
        && after.streak != before.streak
        && after.streak == streak.current
        && streak.updatedAt == request.time
        && !exists(transactionPath)
        && existsAfter(transactionPath)
        && xpTransaction.eventType == 'GOAL_COMPLETED'
        && xpTransaction.cadence == 'daily'
        && xpTransaction.progressId == streak.lastProcessedProgressId
        && xpTransaction.amount == 0
        && after.lastXpTransactionId == before.lastXpTransactionId
        && after.xpWindowStartedAt == before.xpWindowStartedAt
        && after.xpWindowAmount == before.xpWindowAmount
        && after.dailyTaskGoal == before.dailyTaskGoal
        && after.diff(before).affectedKeys().hasOnly([
          'streak',
          'updatedAt'
        ]);
    }

    function hasValidTaskXpTransactionCreate(userId, transactionId) {
      let data = request.resource.data;
      let taskReference = taskPath(userId, transactionId);
      let userProfilePath = profilePath(userId);
      let taskAfter = getAfter(taskReference).data;
      let profileBefore = get(userProfilePath).data;
      let profileAfter = getAfter(userProfilePath).data;
      let expectedAmount = expectedXpTransactionAmount(
        userId,
        taskAfter.priority
      );
      return data.keys().hasOnly([
          'userId',
          'amount',
          'reason',
          'eventType',
          'taskId',
          'taskTitle',
          'createdAt',
          'xpBefore',
          'xpAfter',
          'levelBefore',
          'levelAfter'
        ])
        && data.keys().hasAll([
          'userId',
          'amount',
          'reason',
          'eventType',
          'taskId',
          'taskTitle',
          'createdAt',
          'xpBefore',
          'xpAfter',
          'levelBefore',
          'levelAfter'
        ])
        && transactionId == data.taskId
        && data.userId == userId
        && data.eventType == 'TASK_COMPLETED'
        && data.amount == expectedAmount
        && data.reason == (expectedAmount == 0
          ? 'Limite diário de XP atingido'
          : 'Conclusão de tarefa')
        && data.taskTitle == taskAfter.title
        && data.createdAt == request.time
        && data.xpBefore == profileBefore.xp
        && data.xpAfter == profileBefore.xp + expectedAmount
        && data.levelBefore == profileBefore.level
        && data.levelAfter == profileAfter.level
        && existsAfter(taskReference)
        && taskAfter.status == 'completed'
        && taskAfter.completedAt == request.time
        && (!exists(taskReference)
          || get(taskReference).data.status != 'completed')
        && (expectedAmount == 0
          ? (profileAfter.xp == profileBefore.xp
            && profileAfter.level == profileBefore.level
            && profileAfter.lastXpTransactionId
              == profileBefore.lastXpTransactionId
            && profileAfter.xpWindowStartedAt
              == profileBefore.xpWindowStartedAt
            && profileAfter.xpWindowAmount
              == profileBefore.xpWindowAmount)
          : (profileAfter.lastXpTransactionId == transactionId
            && profileAfter.xp == data.xpAfter
            && profileAfter.level == data.levelAfter));
    }

    function hasValidGoalXpTransactionCreate(userId, transactionId) {
      let data = request.resource.data;
      let completionPath = goalCompletionPath(userId, data.progressId);
      let completion = getAfter(completionPath).data;
      let userProfilePath = profilePath(userId);
      let profileBefore = get(userProfilePath).data;
      let profileAfter = getAfter(userProfilePath).data;
      let expectedAmount = expectedXpAmountForReward(
        profileBefore,
        goalReward(data.cadence)
      );
      return data.keys().hasOnly([
          'userId',
          'amount',
          'reason',
          'eventType',
          'progressId',
          'cadence',
          'createdAt',
          'xpBefore',
          'xpAfter',
          'levelBefore',
          'levelAfter'
        ])
        && data.keys().hasAll([
          'userId',
          'amount',
          'reason',
          'eventType',
          'progressId',
          'cadence',
          'createdAt',
          'xpBefore',
          'xpAfter',
          'levelBefore',
          'levelAfter'
        ])
        && data.userId == userId
        && data.eventType == 'GOAL_COMPLETED'
        && data.progressId is string
        && data.progressId.size() > 0
        && data.progressId.size() <= 192
        && !data.progressId.matches('.*[/].*')
        && isValidGoalCadence(data.cadence)
        && transactionId == 'goal__' + data.progressId
        && data.amount == expectedAmount
        && data.reason == (expectedAmount == 0
          ? 'Limite diário de XP atingido'
          : 'Meta concluída')
        && data.createdAt == request.time
        && data.xpBefore == profileBefore.xp
        && data.xpAfter == profileBefore.xp + expectedAmount
        && data.levelBefore == profileBefore.level
        && data.levelAfter == profileAfter.level
        && profileAfter.xp == data.xpAfter
        && isValidLevelForXp(data.levelAfter, data.xpAfter)
        && !exists(completionPath)
        && existsAfter(completionPath)
        && completion.progressId == data.progressId
        && completion.cadence == data.cadence
        && completion.rewardXp == goalReward(data.cadence)
        && completion.completedAt == request.time
        && (expectedAmount == 0
          ? (profileAfter.level == profileBefore.level
            && profileAfter.lastXpTransactionId
              == profileBefore.lastXpTransactionId
            && profileAfter.xpWindowStartedAt
              == profileBefore.xpWindowStartedAt
            && profileAfter.xpWindowAmount
              == profileBefore.xpWindowAmount)
          : profileAfter.lastXpTransactionId == transactionId);
    }

    function hasProjectCompletionAfter(userId, projectId) {
      let completionPath = projectCompletionPath(userId, projectId);
      let completion = getAfter(completionPath).data;
      return existsAfter(completionPath)
        && completion.userId == userId
        && completion.projectId == projectId
        && completion.completedAt is timestamp;
    }

    function hasValidProjectCompletionCreate(userId, projectId) {
      let data = request.resource.data;
      let sourcePath = projectPath(userId, projectId);
      let projectAfter = getAfter(sourcePath).data;
      return data.keys().hasOnly([
          'userId',
          'projectId',
          'projectName',
          'completedAt'
        ])
        && data.keys().hasAll([
          'userId',
          'projectId',
          'projectName',
          'completedAt'
        ])
        && data.userId == userId
        && data.projectId == projectId
        && data.projectName is string
        && data.projectName == projectAfter.name
        && data.completedAt == projectAfter.updatedAt
        && existsAfter(sourcePath)
        && projectAfter.status == 'completed';
    }

    function hasValidAchievementStatsShape(data) {
      return data.keys().hasOnly([
          'tasksCompleted',
          'pomodorosCompleted',
          'bestStreak',
          'perfectWeeks',
          'projectsCompleted',
          'lastEvidenceId',
          'updatedAt'
        ])
        && data.keys().hasAll([
          'tasksCompleted',
          'pomodorosCompleted',
          'bestStreak',
          'perfectWeeks',
          'projectsCompleted',
          'lastEvidenceId',
          'updatedAt'
        ])
        && data.tasksCompleted is int
        && data.tasksCompleted >= 0
        && data.tasksCompleted <= 1000000000
        && data.pomodorosCompleted is int
        && data.pomodorosCompleted >= 0
        && data.pomodorosCompleted <= 1000000000
        && data.bestStreak is int
        && data.bestStreak >= 0
        && data.bestStreak <= 1000000000
        && data.perfectWeeks is int
        && data.perfectWeeks >= 0
        && data.perfectWeeks <= 1000000000
        && data.projectsCompleted is int
        && data.projectsCompleted >= 0
        && data.projectsCompleted <= 1000000000
        && (data.lastEvidenceId == null
          || (data.lastEvidenceId is string
            && data.lastEvidenceId.size() > 0
            && data.lastEvidenceId.size() <= 192
            && !data.lastEvidenceId.matches('.*[/].*')))
        && data.updatedAt is timestamp;
    }

    function hasExactlyOneAchievementIncrement(before, after, evidence) {
      return (evidence.metric == 'tasksCompleted'
          && after.tasksCompleted == before.tasksCompleted + 1
          && after.pomodorosCompleted == before.pomodorosCompleted
          && after.bestStreak == before.bestStreak
          && after.perfectWeeks == before.perfectWeeks
          && after.projectsCompleted == before.projectsCompleted)
        || (evidence.metric == 'pomodorosCompleted'
          && after.tasksCompleted == before.tasksCompleted
          && after.pomodorosCompleted == before.pomodorosCompleted + 1
          && after.bestStreak == before.bestStreak
          && after.perfectWeeks == before.perfectWeeks
          && after.projectsCompleted == before.projectsCompleted)
        || (evidence.metric == 'bestStreak'
          && after.tasksCompleted == before.tasksCompleted
          && after.pomodorosCompleted == before.pomodorosCompleted
          && after.bestStreak == (int(evidence.sourceId) > before.bestStreak
            ? int(evidence.sourceId)
            : before.bestStreak)
          && after.perfectWeeks == before.perfectWeeks
          && after.projectsCompleted == before.projectsCompleted)
        || (evidence.metric == 'perfectWeeks'
          && after.tasksCompleted == before.tasksCompleted
          && after.pomodorosCompleted == before.pomodorosCompleted
          && after.bestStreak == before.bestStreak
          && after.perfectWeeks == before.perfectWeeks + 1
          && after.projectsCompleted == before.projectsCompleted)
        || (evidence.metric == 'projectsCompleted'
          && after.tasksCompleted == before.tasksCompleted
          && after.pomodorosCompleted == before.pomodorosCompleted
          && after.bestStreak == before.bestStreak
          && after.perfectWeeks == before.perfectWeeks
          && after.projectsCompleted == before.projectsCompleted + 1);
    }

    function hasValidAchievementStatsCreate(statsId) {
      let data = request.resource.data;
      return statsId == 'main'
        && hasValidAchievementStatsShape(data)
        && data.tasksCompleted == 0
        && data.pomodorosCompleted == 0
        && data.bestStreak == 0
        && data.perfectWeeks == 0
        && data.projectsCompleted == 0
        && data.lastEvidenceId == null
        && data.updatedAt == request.time;
    }

    function hasValidAchievementStatsUpdate(userId, statsId) {
      let before = resource.data;
      let after = request.resource.data;
      let evidenceId = after.lastEvidenceId;
      let evidencePath = achievementEvidencePath(userId, evidenceId);
      let evidence = getAfter(evidencePath).data;
      return statsId == 'main'
        && hasValidAchievementStatsShape(after)
        && evidenceId is string
        && evidenceId != before.lastEvidenceId
        && !exists(evidencePath)
        && existsAfter(evidencePath)
        && evidence.recordedAt == request.time
        && after.updatedAt == request.time
        && hasExactlyOneAchievementIncrement(before, after, evidence);
    }

    function hasMatchingStatsIncrementForEvidence(userId, evidenceId, data) {
      let statsPath = achievementStatsPath(userId);
      let before = get(statsPath).data;
      let after = getAfter(statsPath).data;
      return exists(statsPath)
        && existsAfter(statsPath)
        && after.lastEvidenceId == evidenceId
        && after.updatedAt == request.time
        && hasExactlyOneAchievementIncrement(before, after, data);
    }

    function hasValidTaskAchievementEvidence(userId, evidenceId, data) {
      let sourcePath = xpTransactionPath(userId, data.sourceId);
      let source = get(sourcePath).data;
      return data.sourceType == 'TASK_COMPLETED'
        && data.metric == 'tasksCompleted'
        && evidenceId == 'task_completed__' + data.sourceId
        && exists(sourcePath)
        && source.eventType == 'TASK_COMPLETED'
        && source.taskId == data.sourceId
        && source.createdAt == data.occurredAt;
    }

    function hasValidProjectAchievementEvidence(userId, evidenceId, data) {
      let sourcePath = projectCompletionPath(userId, data.sourceId);
      let source = get(sourcePath).data;
      return data.sourceType == 'PROJECT_COMPLETED'
        && data.metric == 'projectsCompleted'
        && evidenceId == 'project_completed__' + data.sourceId
        && exists(sourcePath)
        && source.userId == userId
        && source.projectId == data.sourceId
        && source.completedAt == data.occurredAt;
    }

    function hasValidPomodoroAchievementEvidence(userId, evidenceId, data) {
      let sourcePath = pomodoroSessionPath(userId, data.sourceId);
      let source = get(sourcePath).data;
      return data.sourceType == 'POMODORO_COMPLETED'
        && data.metric == 'pomodorosCompleted'
        && evidenceId == 'pomodoro_completed__' + data.sourceId
        && exists(sourcePath)
        && source.mode == 'focus'
        && source.sessionId == data.sourceId
        && source.completedAt == data.occurredAt;
    }

    function hasValidStreakAchievementEvidence(userId, evidenceId, data) {
      let sourcePath = goalStreakPath(userId);
      let source = get(sourcePath).data;
      return data.sourceType == 'ACTIVITY_STREAK'
        && data.metric == 'bestStreak'
        && data.sourceId.matches('^[1-9][0-9]*$')
        && int(data.sourceId) == source.best
        && evidenceId == 'activity_streak__' + data.sourceId
        && exists(sourcePath)
        && source.lastCompletedAt == data.occurredAt;
    }

    function hasValidAchievementEvidenceCreate(userId, evidenceId) {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'metric',
          'sourceType',
          'sourceId',
          'occurredAt',
          'recordedAt'
        ])
        && data.keys().hasAll([
          'metric',
          'sourceType',
          'sourceId',
          'occurredAt',
          'recordedAt'
        ])
        && data.sourceId is string
        && data.sourceId.size() > 0
        && data.sourceId.size() <= 128
        && !data.sourceId.matches('.*[/].*')
        && data.occurredAt is timestamp
        && data.recordedAt == request.time
        && (hasValidTaskAchievementEvidence(userId, evidenceId, data)
          || hasValidProjectAchievementEvidence(userId, evidenceId, data)
          || hasValidPomodoroAchievementEvidence(userId, evidenceId, data)
          || hasValidStreakAchievementEvidence(userId, evidenceId, data))
        && hasMatchingStatsIncrementForEvidence(userId, evidenceId, data);
    }

    function hasValidAchievementUnlockCreate(userId, achievementId) {
      let data = request.resource.data;
      let statsPath = achievementStatsPath(userId);
      let stats = get(statsPath).data;
      let transactionPath = xpTransactionPath(
        userId,
        achievementTransactionId(achievementId)
      );
      let xpTransaction = getAfter(transactionPath).data;
      let progress = achievementProgress(stats, achievementId);
      return data.keys().hasOnly([
          'achievementId',
          'unlockedAt',
          'progressValue',
          'rewardXp',
          'awardedXp',
          'triggerEvidenceId',
          'definitionVersion'
        ])
        && data.keys().hasAll([
          'achievementId',
          'unlockedAt',
          'progressValue',
          'rewardXp',
          'awardedXp',
          'triggerEvidenceId',
          'definitionVersion'
        ])
        && isKnownAchievement(achievementId)
        && isAchievementSourceAvailable(achievementId)
        && data.achievementId == achievementId
        && data.unlockedAt == request.time
        && data.progressValue == progress
        && data.progressValue >= achievementTarget(achievementId)
        && data.rewardXp == achievementXp(achievementId)
        && data.awardedXp == xpTransaction.amount
        && data.triggerEvidenceId == stats.lastEvidenceId
        && data.triggerEvidenceId is string
        && data.definitionVersion == 1
        && exists(statsPath)
        && !exists(transactionPath)
        && existsAfter(transactionPath)
        && xpTransaction.eventType == 'ACHIEVEMENT_UNLOCKED'
        && xpTransaction.achievementId == achievementId;
    }

    function hasValidAchievementXpTransactionCreate(userId, transactionId) {
      let data = request.resource.data;
      let achievementId = data.achievementId;
      let unlockPath = achievementUnlockPath(userId, achievementId);
      let unlock = getAfter(unlockPath).data;
      let userProfilePath = profilePath(userId);
      let profileBefore = get(userProfilePath).data;
      let profileAfter = getAfter(userProfilePath).data;
      let expectedAmount = expectedXpAmountForReward(
        profileBefore,
        achievementXp(achievementId)
      );
      return data.keys().hasOnly([
          'userId',
          'amount',
          'reason',
          'eventType',
          'achievementId',
          'achievementName',
          'createdAt',
          'xpBefore',
          'xpAfter',
          'levelBefore',
          'levelAfter'
        ])
        && data.keys().hasAll([
          'userId',
          'amount',
          'reason',
          'eventType',
          'achievementId',
          'achievementName',
          'createdAt',
          'xpBefore',
          'xpAfter',
          'levelBefore',
          'levelAfter'
        ])
        && isKnownAchievement(achievementId)
        && isAchievementSourceAvailable(achievementId)
        && transactionId == achievementTransactionId(achievementId)
        && data.userId == userId
        && data.eventType == 'ACHIEVEMENT_UNLOCKED'
        && data.achievementName == achievementName(achievementId)
        && data.amount == expectedAmount
        && data.reason == (expectedAmount == 0
          ? 'Limite diário de XP atingido'
          : 'Conquista desbloqueada')
        && data.createdAt == request.time
        && data.xpBefore == profileBefore.xp
        && data.xpAfter == profileBefore.xp + expectedAmount
        && data.levelBefore == profileBefore.level
        && data.levelAfter == profileAfter.level
        && profileAfter.xp == data.xpAfter
        && isValidLevelForXp(data.levelAfter, data.xpAfter)
        && !exists(unlockPath)
        && existsAfter(unlockPath)
        && unlock.achievementId == achievementId
        && unlock.rewardXp == achievementXp(achievementId)
        && unlock.awardedXp == expectedAmount
        && (expectedAmount == 0
          ? (profileAfter.level == profileBefore.level
            && profileAfter.lastXpTransactionId
              == profileBefore.lastXpTransactionId
            && profileAfter.xpWindowStartedAt
              == profileBefore.xpWindowStartedAt
            && profileAfter.xpWindowAmount
              == profileBefore.xpWindowAmount)
          : profileAfter.lastXpTransactionId == transactionId);
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;

      allow create: if isOwner(userId)
        && hasValidProfileShape(userId)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.level == 1
        && request.resource.data.xp == 0
        && request.resource.data.lastXpTransactionId == null
        && request.resource.data.xpWindowStartedAt == null
        && request.resource.data.xpWindowAmount == 0
        && request.resource.data.streak == 0
        && request.resource.data.primaryObjective == null
        && request.resource.data.dailyTaskGoal == null
        && request.resource.data.onboardingCompleted == false
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isOwner(userId)
        && hasValidProfileShape(userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && (request.resource.data.xp != resource.data.xp
          ? hasValidXpProfileUpdate(userId)
          : request.resource.data.streak != resource.data.streak
            ? hasValidZeroXpGoalStreakProfileUpdate(userId)
            : hasValidRegularProfileUpdate(userId));

      allow delete: if false;

      match /projects/{projectId} {
        allow get, list: if isOwner(userId);

        allow create: if isOwner(userId)
          && hasValidProjectShape()
          && request.resource.data.deletedAt == null
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && (request.resource.data.status == 'archived'
            ? request.resource.data.archivedAt == request.time
            : request.resource.data.archivedAt == null)
          && (request.resource.data.status != 'completed'
            || hasProjectCompletionAfter(userId, projectId));

        allow update: if isOwner(userId)
          && resource.data.deletedAt == null
          && hasValidProjectShape()
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time
          && hasValidProjectArchiveTransition()
          && hasValidProjectDeletionTransition()
          && (!(resource.data.status != 'completed'
              && request.resource.data.status == 'completed')
            || hasProjectCompletionAfter(userId, projectId))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name',
            'description',
            'status',
            'dueAt',
            'category',
            'investedMinutes',
            'updatedAt',
            'archivedAt',
            'deletedAt'
          ]);

        allow delete: if false;
      }

      match /projectCompletions/{projectId} {
        allow get, list: if isOwner(userId);

        allow create: if isOwner(userId)
          && hasValidProjectCompletionCreate(userId, projectId);

        allow update, delete: if false;
      }

      match /achievementStats/{statsId} {
        allow get, list: if isOwner(userId);

        allow create: if isOwner(userId)
          && hasValidAchievementStatsCreate(statsId);

        allow update: if isOwner(userId)
          && hasValidAchievementStatsUpdate(userId, statsId);

        allow delete: if false;
      }

      match /achievementEvidence/{evidenceId} {
        allow get, list: if isOwner(userId);

        allow create: if isOwner(userId)
          && hasValidAchievementEvidenceCreate(userId, evidenceId);

        allow update, delete: if false;
      }

      match /achievements/{achievementId} {
        allow get, list: if isOwner(userId);

        allow create: if isOwner(userId)
          && hasValidAchievementUnlockCreate(userId, achievementId);

        allow update, delete: if false;
      }

      match /goals/{cadence} {
        allow get, list: if isOwner(userId);

        allow create: if isOwner(userId)
          && cadence == request.resource.data.cadence
          && hasValidGoalShape(userId, cadence)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && (cadence != 'daily'
            || hasSynchronizedDailyGoalProfile(userId));

        allow update: if isOwner(userId)
          && cadence == resource.data.cadence
          && hasValidGoalShape(userId, cadence)
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.cadence == resource.data.cadence
          && request.resource.data.rewardXp == resource.data.rewardXp
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'metric',
            'target',
            'active',
            'effectiveFromPeriodKey',
            'updatedAt'
          ])
          && (cadence != 'daily'
            || hasSynchronizedDailyGoalProfile(userId));

        allow delete: if false;
      }

      match /goalProgress/{progressId} {
        allow get, list: if isOwner(userId);

        allow create: if isOwner(userId)
          && hasValidGoalProgressCreate(userId, progressId);

        allow update: if isOwner(userId)
          && hasValidGoalProgressUpdate(userId, progressId);

        allow delete: if false;
      }

      match /goalEvidence/{evidenceId} {
        allow get, list: if isOwner(userId);

        allow create: if isOwner(userId)
          && hasValidGoalEvidenceCreate(userId, evidenceId);

        allow update, delete: if false;
      }

      match /goalCompletions/{progressId} {
        allow get, list: if isOwner(userId);

        allow create: if isOwner(userId)
          && hasValidGoalCompletionCreate(userId, progressId);

        allow update, delete: if false;
      }

      match /goalStreak/{streakId} {
        allow get, list: if isOwner(userId);

        allow create: if isOwner(userId)
          && hasValidGoalStreakCreate(userId, streakId);

        allow update: if isOwner(userId)
          && hasValidGoalStreakUpdate(userId, streakId);

        allow delete: if false;
      }

      match /pomodoroState/{stateId} {
        allow get: if isOwner(userId);

        allow create: if isOwner(userId)
          && hasValidPomodoroCurrentCreate(userId, stateId);

        allow delete: if isOwner(userId) && stateId == 'current';
        allow list, update: if false;
      }

      match /pomodoroSessions/{sessionId} {
        allow get, list: if isOwner(userId);

        allow create: if isOwner(userId)
          && hasValidPomodoroSessionCreate(userId, sessionId);

        allow update, delete: if false;
      }

      match /tasks/{taskId} {
        allow get, list: if isOwner(userId);

        allow create: if isOwner(userId)
          && hasValidTaskShape()
          && hasValidTaskProjectForCreate(userId)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && (request.resource.data.status == 'completed'
            ? (request.resource.data.completedAt == request.time
              && hasXpTransactionAfter(userId, taskId))
            : request.resource.data.completedAt == null);

        allow update: if isOwner(userId)
          && hasValidTaskShape()
          && hasValidTaskProjectForUpdate(userId)
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time
          && hasValidTaskCompletionTransition()
          && (!(resource.data.status != 'completed'
              && request.resource.data.status == 'completed')
            || hasXpTransactionAfter(userId, taskId))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'title',
            'description',
            'category',
            'priority',
            'status',
            'project',
            'projectId',
            'kanbanOrder',
            'dueAt',
            'estimateMinutes',
            'tags',
            'xp',
            'updatedAt',
            'completedAt'
          ]);

        allow delete: if isOwner(userId);
      }

      match /gamificationMeta/clock {
        allow get: if isOwner(userId);

        allow create, update: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['syncedAt'])
          && request.resource.data.keys().hasAll(['syncedAt'])
          && request.resource.data.syncedAt is timestamp
          && request.resource.data.syncedAt == request.time;

        allow list, delete: if false;
      }

      match /xpTransactions/{transactionId} {
        allow get, list: if isOwner(userId);

        allow create: if isOwner(userId)
          && (hasValidTaskXpTransactionCreate(userId, transactionId)
            || hasValidAchievementXpTransactionCreate(
              userId,
              transactionId
            )
            || hasValidGoalXpTransactionCreate(userId, transactionId));

        allow update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
